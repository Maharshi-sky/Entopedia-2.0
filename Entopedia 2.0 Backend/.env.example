NODE_ENV=development
PORT=4000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=entopedia
DB_USER=postgres
DB_PASSWORD=password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
# Required. The API refuses to start without it. Use 32+ random characters
# (e.g. `openssl rand -hex 32`) and give the same value to the frontend as
# ENTOPEDIA_JWT_SECRET.
JWT_SECRET=your_secret_key_change_this_in_production
JWT_EXPIRY=7d

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key

# File upload
MAX_FILE_SIZE=50000000
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info

# CORS (the frontend reads the API from its server, so this only matters for
# browser clients)
CORS_ORIGIN=http://localhost:3000
