NODE_ENV=development
PORT=4000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=entopedia
DB_USER=postgres
DB_PASSWORD=password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
# Required. The API refuses to start without it. Use 32+ random characters
# (e.g. `openssl rand -hex 32`) and give the same value to the frontend as
# ENTOPEDIA_JWT_SECRET.
JWT_SECRET=your_jwt_secret_here

# AI (app/services/groq_service.py). Every AI feature runs on Groq's hosted
# models; no local model server is needed. Key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=openai/gpt-oss-120b          # assistant, summaries, claims, patents
# GROQ_NEWS_MODEL=llama-3.1-8b-instant    # news sorting
# GROQ_VISION_MODEL=qwen/qwen3.8-27b      # Pest Vision (preview model on Groq)

# File upload
MAX_FILE_SIZE=50000000
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info

# CORS (the frontend reads the API from its server, so this only matters for
# browser clients)
CORS_ORIGIN=http://localhost:3000

# News sorting batches (Groq):
# NEWS_AI_BATCH_SIZE=20               # headlines per model call
# NEWS_AI_TIMEOUT_MS=180000           # per model call

# Brand news (see NEWS.md)
# Optional: used only when Google News or a news site refuses a direct request.
ZYTE_API_KEY=
NEWS_REFRESH_DAYS=30
NEWS_REFRESH_COUNTRY=IN               # IN, US, UK, AU, SA, DE
# Automatic refresh while the API runs. Needs GROQ_API_KEY, otherwise stories
# are sorted by keyword only.
NEWS_AUTO_REFRESH=false
NEWS_REFRESH_CRON=0 */6 * * *
NEWS_REFRESH_TIMEZONE=Asia/Kolkata
NEWS_IMAGE_BACKFILL_ON_START=true


#Supabase
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
