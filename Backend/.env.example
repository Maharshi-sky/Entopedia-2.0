NODE_ENV=development
PORT=4000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=entopedia
DB_USER=postgres
DB_PASSWORD=password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
# Required. The API refuses to start without it. Use 32+ random characters
# (e.g. `openssl rand -hex 32`) and give the same value to the frontend as
# ENTOPEDIA_JWT_SECRET.
JWT_SECRET=your_jwt_secret_here_min_32_chars


# AI provider for the assistant, summaries and claims (app/services/llm.py):
#   ollama     local Ollama, model OLLAMA_MODEL (default)
#   anthropic  Claude: also set ANTHROPIC_API_KEY and, optionally, ANTHROPIC_MODEL
# Pest Vision and news sorting always use Ollama.
AI_PROVIDER=ollama
# ANTHROPIC_MODEL=claude-opus-5-5
# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key

# File upload
MAX_FILE_SIZE=50000000
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info

# CORS (the frontend reads the API from its server, so this only matters for
# browser clients)
CORS_ORIGIN=http://localhost:3000

# Local AI (Ollama). Pest Vision uses the vision model; news sorting uses
# OLLAMA_NEWS_MODEL (default: OLLAMA_MODEL, then qwen2.5:7b).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# OLLAMA_NEWS_MODEL=qwen2.5:3b        # faster, less accurate
# NEWS_AI_BATCH_SIZE=20               # headlines per model call
# NEWS_AI_TIMEOUT_MS=180000           # per model call

# Brand news (see NEWS.md)
# Optional: used only when Google News or a news site refuses a direct request.
ZYTE_API_KEY=
NEWS_REFRESH_DAYS=30
NEWS_REFRESH_COUNTRY=IN               # IN, US, UK, AU, SA, DE
# Automatic refresh while the API runs. Turn on only where Ollama is reachable,
# otherwise stories are sorted by keyword only.
NEWS_AUTO_REFRESH=false
NEWS_REFRESH_CRON=0 */6 * * *
NEWS_REFRESH_TIMEZONE=Asia/Kolkata
NEWS_IMAGE_BACKFILL_ON_START=true


#Supabase
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
